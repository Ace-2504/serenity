# Copy to .env next to docker-compose.yml and replace every "change-me" value.
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
AUTH_SECRET=change-me
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me
APP_PORT=3000
# The address customers use to reach this app (unsubscribe links in emails).
APP_URL=http://localhost:3000
# Retrain models after each import (1 = yes).
ML_AUTORUN=
# Assistant model (with: docker compose --profile llm up -d).
LLM_MODEL=qwen2.5:7b-instruct
# Leave empty to keep campaign messages in the local outbox (nothing is sent).
SMTP_URL=
SMTP_FROM=
# 1 only behind a reverse proxy that sets X-Forwarded-For (enables per-address rate limits).
TRUST_PROXY=
# Sign-in cookies need HTTPS. Opening the app over plain http:// from another computer (not
# localhost) needs COOKIE_SECURE=0; prefer HTTPS through a reverse proxy instead.
COOKIE_SECURE=
# Tally on this same computer: use http://host.docker.internal:9000 as the Tally address.
# 1 only if Tally's server is reachable from outside your network and you have secured it.
TALLY_ALLOW_REMOTE=
# Amazon Selling Partner API app credentials (leave empty to upload settlement reports instead).
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
