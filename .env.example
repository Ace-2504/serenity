DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stationery_webapp"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/stationery_webapp"
# Separate database for `npm run test:int`; its contents are created and deleted by tests.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/serenity_test"
NEXT_PUBLIC_APP_NAME="Stationery Webapp"
AUTH_SECRET="change-me-to-a-long-random-secret"
ADMIN_EMAIL="admin@stationery.local"
ADMIN_PASSWORD="ChangeMe@123"
RAZORPAY_ENABLED="false"
NEXT_PUBLIC_RAZORPAY_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Background jobs: unset = the web process runs queued jobs itself (one server / Docker).
# "worker" = the web process only enqueues; run `npm run worker` separately.
JOBS_MODE=""

# ML worker (Python, ml/). Default interpreter: ml/.venv/bin/python. ML_AUTORUN=1 retrains after each import.
ML_PYTHON=""
ML_AUTORUN=""

# Assistant (M9): any OpenAI-compatible local server, e.g. Ollama. Without one, answers come from report templates.
# A non-local LLM_BASE_URL is refused unless LLM_ALLOW_REMOTE=1 (questions and report results would leave this machine).
LLM_BASE_URL="http://localhost:11434"
LLM_MODEL="qwen2.5:7b-instruct"
LLM_API_KEY=""
LLM_ALLOW_REMOTE=""

# Campaigns (M9): unset SMTP_URL = messages stay in the local outbox, nothing is sent.
SMTP_URL=""
SMTP_FROM=""
# Base URL used in unsubscribe links.
APP_URL="http://localhost:3000"
